# Copy to .env and fill in. See docs/feishu-setup.md for how to obtain the
# Feishu values, and docs/interface-spec.md section 7 for the full list.

# --- Feishu self-built app (long connection, no public URL needed) ----------
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The ONE user allowed to control the AC (your own open_id, ou_...).
# Leave it blank for the first run -- the service logs the open_id of whoever
# messages it, so you can read it off and paste it here.
OWNER_OPEN_ID=

# --- MQTT broker: Mosquitto on this same Raspberry Pi ----------------------
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_PREFIX=ac
MQTT_CLIENT_ID=ac-bot

# --- Behaviour (defaults are fine; see app/config.py) ---------------------
LOG_LEVEL=INFO
# Verbosity of the lark-oapi socket only. Set DEBUG to see raw WS traffic
# (useful when no events are arriving); INFO otherwise.
FEISHU_LOG_LEVEL=INFO
# Seconds the OpenAPI client waits before giving up on one call. The SDK's own
# default is 30, and every call retries once -- so a dead internet could hold
# the card-patching thread (and, before design 18.15, the heartbeat) for a minute.
FEISHU_TIMEOUT_S=5
# Rapid taps within this window collapse into a single ac/cmd.
DEBOUNCE_MS=400
# No ac/state back within this long -> the card shows "⚠️ 未确认".
CONFIRM_TIMEOUT_S=5
# Online but silent for longer than this -> soft "may be stale" note.
STALE_AFTER_S=90
# Understand plain Chinese short sentences ("调低两度") as commands, not just the
# summon word "设置卡片".
# Set to false to fall back to "only 设置卡片 posts the card".
TEXT_CONTROL_ENABLED=true
# Local development: relative to the working directory; no root required.
# Production systemd deployment uses /var/lib/ac-bot/ac-bot.sqlite3 instead.
DB_PATH=ac-bot.sqlite3

# --- v1.2: DHT11 feedback, weather suggestion, night loop -----------------
# How often the latest ac/env reading is appended to the history (seconds).
DHT_RECORD_S=300
# Default time the daily weather suggestion is pushed. Editable on the ⚙️ 设置
# card, so this only seeds the very first push.
WEATHER_DEFAULT_PUSH=17:00
# Optional lat/lon override; leave blank to geolocate by public IP.
# Setting these avoids the IP lookup (one fewer HTTPS call per push).
WEATHER_LAT=
WEATHER_LON=
# Night closed loop defaults -- all editable on the ⚙️ 设置 card.
NIGHT_DEFAULT_TARGET=26
NIGHT_DEFAULT_START=23:00
NIGHT_DEFAULT_END=07:00
# How often the service publishes ac/hb. Must be well under the firmware's
# LINK_LOST_OFF_S (5 min), or the device's fail-safe will trip on a healthy
# service.
HB_INTERVAL_S=30
