# Copy to .env and fill in. See docs/feishu-setup.md for how to obtain the
# Feishu values, and docs/interface-spec.md section 7 for the full list.

# --- Feishu self-built app (long connection, no public URL needed) ----------
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The ONE user allowed to control the AC (your own open_id, ou_...).
# Leave it blank for the first run -- the service logs the open_id of whoever
# messages it, so you can read it off and paste it here.
OWNER_OPEN_ID=

# --- MQTT broker: Mosquitto on this same Raspberry Pi ----------------------
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_PREFIX=ac
MQTT_CLIENT_ID=ac-bot

# --- Behaviour (defaults are fine; see app/config.py) ---------------------
LOG_LEVEL=INFO
# Verbosity of the lark-oapi socket only. Set DEBUG to see raw WS traffic
# (useful when no events are arriving); INFO otherwise.
FEISHU_LOG_LEVEL=INFO
# Rapid taps within this window collapse into a single ac/cmd.
DEBOUNCE_MS=400
# No ac/state back within this long -> the card shows "⚠️ 未确认".
CONFIRM_TIMEOUT_S=5
# Online but silent for longer than this -> soft "may be stale" note.
STALE_AFTER_S=90
# Understand plain Chinese short sentences ("调低两度") as commands, not just the
# summon word "设置卡片".
# Set to false to fall back to "only 设置卡片 posts the card".
TEXT_CONTROL_ENABLED=true
DB_PATH=/var/lib/ac-bot/ac-bot.sqlite3
