# Production template: install manually as /etc/ac-bot/ac-bot.env (root:root 0600).
# systemd reads this file; app.config otherwise loads .env from WorkingDirectory.
# Do not put a .env in /opt/ac-bot; process environment takes precedence.
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_me
OWNER_OPEN_ID=ou_replace_me
# If broker binds only its LAN IP, use that IP here (see docs/deployment.md).
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=ac-bot
MQTT_PASS=replace_me
MQTT_PREFIX=ac
MQTT_CLIENT_ID=ac-bot
# EnvironmentFile overrides Environment= in the unit: retain this production path.
DB_PATH=/var/lib/ac-bot/ac-bot.sqlite3
LOG_LEVEL=INFO
FEISHU_LOG_LEVEL=INFO
HB_INTERVAL_S=30
