# Review before installing; see docs/deployment.md. No installer touches services.
# Dedicated account: ac-bot; checkout and frozen virtualenv: /opt/ac-bot.
# EnvironmentFile is mandatory. Keep DB_PATH there aligned with StateDirectory.
[Unit]
Description=Feishu to ESP32 AC gateway bridge
After=network-online.target mosquitto.service
Wants=network-online.target
# Keep all three relationships: stop, restart propagation, and start pull-in.
Requires=mosquitto.service
PartOf=mosquitto.service

[Service]
Type=simple
User=ac-bot
Group=ac-bot
WorkingDirectory=/opt/ac-bot
EnvironmentFile=/etc/ac-bot/ac-bot.env
StateDirectory=ac-bot
StateDirectoryMode=0750
Environment=DB_PATH=/var/lib/ac-bot/ac-bot.sqlite3
ExecStart=/opt/ac-bot/.venv/bin/python -m app.main
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
Nice=5

[Install]
WantedBy=multi-user.target
# Requires alone will not restart us after a separate broker stop/start.
WantedBy=mosquitto.service
